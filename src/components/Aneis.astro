---
// Anéis finos com marcações, como um mostrador. Giram conforme a página rola
// (o elemento pai precisa ter data-progresso, que define --p).
interface Props {
  class?: string;
  claro?: boolean;
}
const { class: classe, claro = false } = Astro.props;

const marcas = Array.from({ length: 72 }, (_, indice) => {
  const angulo = (indice / 72) * Math.PI * 2;
  const longa = indice % 6 === 0;
  const r1 = 196;
  const r2 = longa ? 182 : 189;
  return {
    x1: (200 + r1 * Math.cos(angulo)).toFixed(2),
    y1: (200 + r1 * Math.sin(angulo)).toFixed(2),
    x2: (200 + r2 * Math.cos(angulo)).toFixed(2),
    y2: (200 + r2 * Math.sin(angulo)).toFixed(2),
    longa,
  };
});
---

<div class:list={['aneis', { 'aneis--claro': claro }, classe]} aria-hidden="true">
  <svg class="aneis__externo" viewBox="0 0 400 400">
    {marcas.map((m) => <line x1={m.x1} y1={m.y1} x2={m.x2} y2={m.y2} class:list={{ longa: m.longa }} />)}
    <circle cx="200" cy="200" r="198" />
  </svg>
  <svg class="aneis__meio" viewBox="0 0 400 400">
    <circle cx="200" cy="200" r="150" stroke-dasharray="2 10" />
    <circle class="aneis__ponto" cx="200" cy="50" r="4" />
  </svg>
  <svg class="aneis__interno" viewBox="0 0 400 400">
    <circle cx="200" cy="200" r="108" />
    <path d="M92 200 A108 108 0 0 1 200 92" class="aneis__arco" />
  </svg>
</div>

<style>
  .aneis {
    --cor: var(--azul-claro);
    position: relative;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .aneis--claro {
    --cor: var(--marinho);
  }

  .aneis svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--cor);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: transform 0.1s linear;
  }

  .aneis line {
    opacity: 0.35;
  }

  .aneis line.longa {
    opacity: 0.7;
  }

  .aneis__externo circle {
    opacity: 0.25;
  }

  .aneis__meio circle {
    opacity: 0.45;
  }

  .aneis__meio .aneis__ponto {
    fill: var(--cor);
    stroke: none;
    opacity: 0.9;
  }

  .aneis__interno circle {
    opacity: 0.2;
  }

  .aneis__arco {
    stroke-width: 2;
    opacity: 0.8;
  }

  .aneis__externo {
    transform: rotate(calc(var(--p, 0.5) * 120deg));
  }

  .aneis__meio {
    transform: rotate(calc(var(--p, 0.5) * -220deg));
  }

  .aneis__interno {
    transform: rotate(calc(var(--p, 0.5) * 300deg));
  }
</style>
