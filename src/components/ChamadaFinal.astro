---
// Chamada final em azul escuro, com o globo de pontos e Praia Grande marcada.
import Globo from './Globo.astro';
import Icone from './Icone.astro';
import { linkWhatsApp } from '../config';

interface Props {
  titulo?: string;
  texto?: string;
  botao?: string;
  mensagem?: string;
}

const {
  titulo = 'Sua próxima ideia começa aqui.',
  texto = 'Manda uma mensagem contando o que você precisa. Quem responde é a gente mesmo.',
  botao = 'Conte pra gente o que você precisa',
  mensagem = 'Oi! Vim pelo site da Orla e queria contar o que eu preciso.',
} = Astro.props;
---

<section class="chamada" aria-labelledby="chamada-titulo">
  <div class="conteiner">
    <div class="chamada__caixa escuro">
      <div class="chamada__texto">
        <p class="rotulo">Vamos conversar</p>
        <h2 id="chamada-titulo">{titulo}</h2>
        <p class="apoio">{texto}</p>
        <a class="botao" href={linkWhatsApp(mensagem)} target="_blank" rel="noopener">
          <Icone nome="message-circle" />
          {botao}
        </a>
      </div>
      <div class="chamada__globo">
        <Globo cor="#e9eef4" />
        <p class="chamada__lugar">
          <Icone nome="map-pin" />
          Praia Grande, SP. Atendemos todo o Brasil.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .chamada {
    padding-block: var(--secao);
  }

  .chamada__caixa {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 1rem + 4vw, 4.5rem);
    border-radius: calc(var(--raio-painel) + 8px);
    overflow: hidden;
  }

  .chamada__texto {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .chamada h2 {
    max-width: 13em;
  }

  .chamada .botao {
    margin-top: 1rem;
  }

  .chamada__globo {
    position: relative;
    width: min(100%, 26rem);
    justify-self: center;
  }

  .chamada__lugar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: var(--t-pequeno);
    color: var(--acento);
  }

  @media (max-width: 47.99rem) {
    .chamada .botao {
      width: 100%;
    }

    .chamada__globo {
      width: min(100%, 18rem);
    }
  }

  @media (min-width: 60rem) {
    .chamada__caixa {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: 3rem;
    }
  }
</style>
