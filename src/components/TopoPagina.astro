---
// Topo das páginas internas: texto à esquerda, tela de exemplo à direita (slot "visual"),
// linha do horizonte e ondas embaixo, como no início.
import Onda from './Onda.astro';
import Mar from './Mar.astro';

interface Props {
  rotulo: string;
  titulo: string;
  id?: string;
}

const { rotulo, titulo, id = 'topo-titulo' } = Astro.props;
const temVisual = Astro.slots.has('visual');
---

<section class:list={['topo amanhecer', { 'topo--visual': temVisual }]} aria-labelledby={id} data-progresso>
  <div class="conteiner topo__grade">
    <div class="topo__texto">
      <p class="rotulo">{rotulo}</p>
      <h1 id={id}>{titulo}</h1>
      <div class="topo__apoio apoio">
        <slot />
      </div>
      {
        Astro.slots.has('botoes') && (
          <div class="topo__botoes">
            <slot name="botoes" />
          </div>
        )
      }
    </div>
    {
      temVisual && (
        <div class="topo__visual">
          <slot name="visual" />
        </div>
      )
    }
  </div>
  <div class="topo__mar" aria-hidden="true">
    <Mar />
    <Onda tipo="linhas" class="topo__ondas" />
  </div>
</section>

<style>
  .topo {
    --altura-ondas: clamp(7rem, 4rem + 9vw, 12rem);
    position: relative;
    padding-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-bottom: calc(var(--altura-ondas) + clamp(2.5rem, 2rem + 2vw, 4rem));
    overflow: hidden;
  }

  .topo__grade {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .topo .rotulo {
    margin-bottom: 1.5rem;
  }

  .topo h1 {
    max-width: 14em;
  }

  .topo__apoio {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
    max-width: 32em;
  }

  .topo__botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .topo__visual {
    justify-self: center;
    width: min(100%, 30rem);
  }

  .topo__mar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--altura-ondas);
    border-top: 1px solid var(--linha);
  }

  .topo__mar :global(.topo__ondas) {
    position: absolute;
    left: 0;
    right: 0;
    top: -1.5rem;
    height: 3.5rem;
    opacity: 0.8;
  }

  @media (max-width: 47.99rem) {
    .topo__botoes :global(.botao) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 60rem) {
    .topo--visual .topo__grade {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }

    .topo--visual .topo__visual {
      justify-self: end;
    }

    .topo:not(.topo--visual) h1 {
      font-size: clamp(2.5rem, 1.5rem + 4.4vw, 5.25rem);
      max-width: 14em;
    }
  }
</style>
