---
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import Conversa, { type Mensagem } from '../components/Conversa.astro';
import Icone from '../components/Icone.astro';
import Aneis from '../components/Aneis.astro';
import Onda from '../components/Onda.astro';
import Faq from '../components/Faq.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import { linkWhatsApp } from '../config';

const conversa: Mensagem[] = [
  {
    de: 'empresa',
    hora: '09:00',
    texto: 'Oi, Carla! Passando para lembrar da sua avaliação de fisioterapia na quinta às 18h.',
    opcoes: ['Confirmar', 'Remarcar'],
  },
  { de: 'cliente', hora: '09:04', texto: 'Remarcar', escolhida: 'Remarcar' },
  {
    de: 'empresa',
    hora: '09:04',
    texto: 'Sem problema. Tenho estes horários:',
    opcoes: ['Sexta, 8h', 'Sexta, 17h', 'Segunda, 18h'],
  },
  { de: 'cliente', hora: '09:05', texto: 'Segunda, 18h', escolhida: 'Segunda, 18h' },
  {
    de: 'empresa',
    hora: '09:05',
    texto: 'Remarcado para segunda às 18h. No sábado e no dia eu te lembro de novo.',
  },
];

const funcoes = [
  {
    icone: 'clock',
    titulo: 'Responde a qualquer hora',
    texto: 'Quem manda mensagem às 23h ou no domingo recebe resposta na hora, com as informações do seu negócio.',
  },
  {
    icone: 'calendar-check',
    titulo: 'Marca, remarca e cancela',
    texto: 'Direto na sua agenda. Ninguém precisa copiar horário de um lugar para o outro.',
  },
  {
    icone: 'bell-ring',
    titulo: 'Lembra 2 dias antes e no dia',
    texto: 'Com botões de confirmar ou remarcar. O cliente resolve com um toque.',
  },
  {
    icone: 'list-restart',
    titulo: 'Cuida da lista de espera',
    texto: 'Quando alguém cancela, ela oferece o horário para quem estava esperando.',
  },
  {
    icone: 'message-circle',
    titulo: 'Tira dúvidas',
    texto: 'Endereço, forma de pagamento, preparo para o atendimento: tudo o que você ensinar para ela.',
  },
  {
    icone: 'headset',
    titulo: 'Chama alguém da equipe',
    texto: 'Quando o assunto foge do roteiro, ela avisa uma pessoa e passa a conversa.',
  },
];

const naoFaz = [
  {
    titulo: 'Não dá orientação de saúde',
    texto: 'Pergunta sobre sintoma, remédio ou tratamento vai direto para a sua equipe.',
  },
  {
    titulo: 'Não inventa preço nem condição',
    texto: 'Ela só responde o que está nas informações que você aprovou.',
  },
  {
    titulo: 'Não segura quem precisa de gente',
    texto: 'Reclamação, caso delicado ou pedido diferente: ela chama uma pessoa da equipe.',
  },
];

const fluxo = [
  {
    icone: 'message-circle',
    titulo: 'Chega a mensagem',
    texto: 'O cliente escreve no WhatsApp da sua empresa, a qualquer hora.',
  },
  {
    icone: 'book-open',
    titulo: 'Ela consulta o que você ensinou',
    texto: 'Serviços, endereço, formas de pagamento e regras da agenda. Tudo aprovado por você.',
  },
  {
    icone: 'calendar-check',
    titulo: 'Olha a agenda de verdade',
    texto: 'Oferece só horários livres, marca ou remarca e já deixa os lembretes programados.',
  },
  {
    icone: 'headset',
    titulo: 'Chama alguém quando precisa',
    texto: 'Se o assunto foge do roteiro, ela avisa a sua equipe e passa a conversa.',
  },
];

const perguntas = [
  {
    pergunta: 'O cliente vai perceber que está falando com uma IA?',
    resposta:
      'Ela se apresenta como assistente virtual da sua empresa. A conversa é natural, e a qualquer momento o cliente pode pedir para falar com uma pessoa.',
  },
  {
    pergunta: 'Preciso trocar o número do WhatsApp?',
    resposta:
      'Na maioria dos casos dá para usar o número que você já tem. A gente confere isso com você antes de começar.',
  },
  {
    pergunta: 'Funciona com a agenda que eu já uso?',
    resposta:
      'Depende do sistema. Na primeira conversa a gente vê qual agenda você usa e como conectar, antes de você fechar qualquer coisa.',
  },
  {
    pergunta: 'E se ela não souber responder?',
    resposta: 'Ela avisa alguém da sua equipe e diz para o cliente que uma pessoa vai continuar a conversa.',
  },
  {
    pergunta: 'Serve só para clínica?',
    resposta:
      'Não. Clínicas são o nosso primeiro foco, mas ela funciona para qualquer negócio que atende e agenda pelo WhatsApp, como salão, estúdio, oficina ou escritório.',
  },
  {
    pergunta: 'Quanto custa?',
    resposta:
      'Depende do tamanho da sua operação e do que precisa estar conectado. A gente passa o valor depois da primeira conversa, sem compromisso.',
  },
];
---

<Base
  titulo="Secretária IA para WhatsApp"
  descricao="A Secretária IA atende o WhatsApp da sua empresa 24 horas, tira dúvidas, marca e remarca na agenda, cuida da lista de espera e lembra o cliente 2 dias antes e no dia. API oficial do WhatsApp."
>
  <TopoPagina rotulo="Secretária IA" titulo="O WhatsApp da sua empresa respondido a qualquer hora.">
    <p>
      A Secretária IA tira dúvidas com as informações do seu negócio, marca, remarca e cancela direto na agenda e
      lembra o cliente antes do horário. Quando o assunto foge do roteiro, ela chama alguém da sua equipe.
    </p>
    <Fragment slot="botoes">
      <a
        class="botao"
        href={linkWhatsApp('Oi! Quero saber mais sobre a Secretária IA.')}
        target="_blank"
        rel="noopener"
      >
        <Icone nome="message-circle" />
        Quero uma Secretária IA
      </a>
      <a class="botao botao--contorno" href="#por-dentro">Ver como funciona</a>
    </Fragment>
    <Conversa
      slot="visual"
      contato="Sua clínica"
      mensagens={conversa}
      legenda="Exemplo de lembrete com remarcação"
    />
  </TopoPagina>

  <section class="secao" aria-labelledby="faz-titulo">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--lado">
        <h2 id="faz-titulo">O que ela faz por você</h2>
        <p class="apoio">Tudo pelo WhatsApp que o seu cliente já usa, conectado com a sua agenda.</p>
      </div>
      <ul class="lista-icones lista-icones--duas">
        {
          funcoes.map((funcao) => (
            <li data-revelar>
              <span class="selo-icone">
                <Icone nome={funcao.icone} />
              </span>
              <div class="bloco">
                <h3>{funcao.titulo}</h3>
                <p>{funcao.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Único dado de mercado da página -->
  <section class="secao faltas" aria-labelledby="faltas-titulo" data-progresso>
    <div class="conteiner faltas__grade">
      <div class="faltas__texto">
        <h2 id="faltas-titulo">Lembrete que o cliente responde com um toque.</h2>
        <p>
          Um levantamento da Botdesigner com hospitais privados brasileiros aponta faltas em torno de 20% ao mês. Com
          confirmação automática, esse número cai pela metade.
        </p>
        <p>
          A Secretária manda o lembrete 2 dias antes e no dia, com botões de confirmar ou remarcar. Se alguém desmarca,
          o horário vai para a lista de espera.
        </p>
      </div>
      <div class="faltas__grafico painel" role="img" aria-label="Faltas por mês: cerca de 20% sem confirmação automática e cerca de 10% com confirmação automática.">
        <div class="faltas__linha">
          <span class="faltas__numero">20%</span>
          <span class="faltas__rotulo">Faltas sem confirmação automática</span>
          <span class="faltas__barra"><span style="--alvo: 1"></span></span>
        </div>
        <div class="faltas__linha faltas__linha--destaque">
          <span class="faltas__numero">10%</span>
          <span class="faltas__rotulo">Com confirmação automática</span>
          <span class="faltas__barra"><span style="--alvo: 0.5"></span></span>
        </div>
        <p class="faltas__fonte">Fonte: levantamento da Botdesigner com hospitais privados brasileiros.</p>
      </div>
    </div>
  </section>

  <Onda cor="var(--nevoa)" />
  <section class="secao claro" aria-labelledby="nao-faz-titulo">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--lado">
        <h2 id="nao-faz-titulo">O que ela não faz</h2>
        <p class="apoio">Ela segue o que você aprovou. O resto vai para uma pessoa da sua equipe.</p>
      </div>
      <ul class="nao-faz">
        {
          naoFaz.map((item) => (
            <li data-revelar>
              <span class="selo-icone">
                <Icone nome="circle-x" />
              </span>
              <div class="bloco">
                <h3>{item.titulo}</h3>
                <p>{item.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <Onda cor="var(--nevoa)" invertida />

  <section class="secao" id="por-dentro" aria-labelledby="dentro-titulo">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--lado">
        <h2 id="dentro-titulo">Como ela funciona por dentro</h2>
        <p class="apoio">Sem complicação: ela só responde com o que você ensinou e só marca no que está livre.</p>
      </div>
      <ol class="fluxo" data-progresso>
        <span class="fluxo__trilho" aria-hidden="true"><span class="fluxo__ponto"></span></span>
        {
          fluxo.map((passo, indice) => (
            <li class="fluxo__passo">
              <span class="fluxo__no">
                <Icone nome={passo.icone} />
              </span>
              <div class="bloco">
                <p class="fluxo__numero">Passo {indice + 1}</p>
                <h3>{passo.titulo}</h3>
                <p>{passo.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="secao seguranca" aria-labelledby="seguranca-titulo" data-progresso>
    <div class="conteiner seguranca__grade">
      <div class="seguranca__simbolo" aria-hidden="true">
        <Aneis class="seguranca__aneis" />
        <span class="seguranca__escudo"><Icone nome="shield-check" /></span>
      </div>
      <div>
        <h2 id="seguranca-titulo">Seguro para você e para o seu cliente</h2>
        <ul class="lista-icones seguranca__lista">
          <li>
            <span class="selo-icone"><Icone nome="badge-check" /></span>
            <div class="bloco">
              <h3>WhatsApp oficial</h3>
              <p>Usamos a API oficial do WhatsApp, da Meta. Sem gambiarra e sem risco de bloquear o seu número.</p>
            </div>
          </li>
          <li>
            <span class="selo-icone"><Icone nome="lock" /></span>
            <div class="bloco">
              <h3>LGPD</h3>
              <p>Os dados dos seus clientes servem só para atender e agendar, e são apagados quando você pedir.</p>
            </div>
          </li>
          <li>
            <span class="selo-icone"><Icone nome="eye-off" /></span>
            <div class="bloco">
              <h3>Dados mínimos</h3>
              <p>Ela pede só o necessário para marcar, como nome e horário. Nada de exame ou prontuário pela conversa.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <Faq itens={perguntas} />

  <ChamadaFinal
    titulo="Vamos montar a sua Secretária IA."
    texto="Conta como funciona o seu atendimento hoje. A gente mostra como ela ficaria no seu negócio."
    botao="Quero uma Secretária IA"
    mensagem="Oi! Quero saber mais sobre a Secretária IA."
  />
</Base>

<style>
  /* Faltas */
  .faltas {
    background: var(--marinho-fundo);
  }

  .faltas__grade {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .faltas__texto {
    display: grid;
    gap: 1.25rem;
    max-width: 34em;
  }

  .faltas__texto h2 {
    margin-bottom: 0.5rem;
  }

  .faltas__texto p {
    color: var(--azul-claro);
  }

  .faltas__grafico {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .faltas__linha {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 1.25rem;
    row-gap: 0.85rem;
  }

  .faltas__numero {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--azul-claro);
  }

  .faltas__linha--destaque .faltas__numero {
    color: var(--branco);
  }

  .faltas__rotulo {
    color: var(--azul-claro);
  }

  .faltas__barra {
    grid-column: 1 / -1;
    height: 6px;
    border-radius: 6px;
    background: rgba(185, 204, 224, 0.12);
    overflow: hidden;
  }

  .faltas__barra span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--azul-claro);
    width: calc(var(--alvo) * 100% * clamp(0, calc((var(--p, 1) - 0.15) * 2.5), 1));
  }

  .faltas__linha--destaque .faltas__barra span {
    background: var(--branco);
  }

  .faltas__fonte {
    font-size: 0.8125rem;
    color: var(--azul-claro);
  }

  /* O que não faz */
  .nao-faz {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .nao-faz li {
    display: flex;
    gap: 1.25rem;
    padding: 1.75rem;
    border: 1px solid var(--linha-clara);
    border-radius: var(--raio-painel);
    background: var(--branco);
  }

  /* Fluxo por dentro */
  .fluxo {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  .fluxo__trilho {
    position: absolute;
    left: 1.75rem;
    top: 1.75rem;
    bottom: 1.75rem;
    width: 1px;
    background: var(--linha);
  }

  .fluxo__ponto {
    position: absolute;
    left: -4px;
    top: calc(clamp(0, calc((var(--p, 0.5) - 0.2) * 1.7), 1) * 100%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--branco);
    box-shadow: 0 0 0 6px rgba(185, 204, 224, 0.15);
  }

  .fluxo__passo {
    position: relative;
    display: flex;
    gap: 1.5rem;
  }

  .fluxo__no {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--borda-painel);
    border-radius: 50%;
    background: var(--marinho-painel);
    color: var(--azul-claro);
  }

  .bloco .fluxo__numero {
    margin: 0.15rem 0 0.25rem;
    color: var(--azul-claro);
    font-weight: 500;
  }

  /* Segurança */
  .seguranca {
    overflow: hidden;
  }

  .seguranca__grade {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .seguranca__simbolo {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    justify-self: center;
  }

  .seguranca__simbolo :global(.seguranca__aneis) {
    position: absolute;
    inset: 0;
  }

  .seguranca__escudo {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: var(--branco);
    color: var(--marinho);
  }

  .seguranca__escudo :global(.icone) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .seguranca h2 {
    margin-bottom: 2rem;
  }

  @media (min-width: 60rem) {
    .faltas__grade,
    .seguranca__grade {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 5rem;
    }

    .seguranca__grade {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    .nao-faz {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .nao-faz li {
      flex-direction: column;
    }

    .fluxo {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }

    .fluxo__trilho {
      left: 1.75rem;
      right: 1.75rem;
      top: 1.75rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .fluxo__ponto {
      top: -4px;
      left: calc(clamp(0, calc((var(--p, 0.5) - 0.2) * 1.7), 1) * 100%);
    }

    .fluxo__passo {
      flex-direction: column;
    }
  }
</style>
