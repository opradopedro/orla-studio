---
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import Icone from '../components/Icone.astro';
import { contato, linkWhatsApp, site } from '../config';
---

<Base
  titulo="Contato"
  descricao="Fale com a Orla Studio pelo WhatsApp, por e-mail ou pelo formulário. Estúdio de tecnologia em Praia Grande (SP), atendendo a Baixada Santista e todo o Brasil."
>
  <TopoPagina rotulo="Contato" titulo="Vamos conversar.">
    <p>O jeito mais rápido é pelo WhatsApp. Quem responde é a gente mesmo.</p>
    <Fragment slot="botoes">
      <a class="botao" href={linkWhatsApp()} target="_blank" rel="noopener">
        <Icone nome="message-circle" />
        Falar no WhatsApp
      </a>
    </Fragment>
  </TopoPagina>

  <section class="secao contato" aria-label="Formas de contato">
    <div class="conteiner contato__grade">
      <ul class="canais">
        <li>
          <a class="canal canal--principal" href={linkWhatsApp()} target="_blank" rel="noopener">
            <span class="selo-icone"><Icone nome="message-circle" /></span>
            <span class="bloco">
              <strong>WhatsApp</strong>
              <span class="canal__texto">{contato.telefoneExibicao}</span>
            </span>
            <Icone nome="arrow-up-right" class="canal__seta" />
          </a>
        </li>
        <li>
          <a class="canal" href={`mailto:${contato.email}`}>
            <span class="selo-icone"><Icone nome="mail" /></span>
            <span class="bloco">
              <strong>E-mail</strong>
              <span class="canal__texto">{contato.email}</span>
            </span>
            <Icone nome="arrow-up-right" class="canal__seta" />
          </a>
        </li>
        <li>
          <a class="canal" href={contato.instagram} target="_blank" rel="noopener">
            <span class="selo-icone"><Icone nome="camera" /></span>
            <span class="bloco">
              <strong>Instagram</strong>
              <span class="canal__texto">{contato.instagramUsuario}</span>
            </span>
            <Icone nome="arrow-up-right" class="canal__seta" />
          </a>
        </li>
        <li class="canal canal--local">
          <span class="selo-icone"><Icone nome="map-pin" /></span>
          <span class="bloco">
            <strong>{site.cidade}, {site.estado}</strong>
            <span class="canal__texto">Atendemos a Baixada Santista e todo o Brasil.</span>
          </span>
        </li>
      </ul>

      <form
        class="formulario painel"
        action={`https://wa.me/${contato.whatsapp}`}
        method="get"
        target="_blank"
        data-formulario
        data-whatsapp={contato.whatsapp}
        novalidate
        aria-labelledby="formulario-titulo"
      >
        <div class="bloco formulario__cabeca">
          <h2 id="formulario-titulo">Prefere escrever aqui?</h2>
          <p>Preencha e a mensagem abre pronta no seu WhatsApp. É só enviar.</p>
        </div>

        <div class="campo">
          <label for="nome">Seu nome</label>
          <input id="nome" name="nome" type="text" autocomplete="name" required aria-describedby="nome-erro" />
          <p class="campo__erro" id="nome-erro" hidden>Escreva o seu nome.</p>
        </div>

        <div class="campo">
          <label for="empresa">Empresa <span>(opcional)</span></label>
          <input id="empresa" name="empresa" type="text" autocomplete="organization" />
        </div>

        <div class="campo">
          <label for="precisa">O que você precisa</label>
          <textarea
            id="precisa"
            name="text"
            rows="5"
            required
            aria-describedby="precisa-erro"
            placeholder="Ex.: quero que o WhatsApp da clínica marque horários sozinho"></textarea>
          <p class="campo__erro" id="precisa-erro" hidden>Conte em poucas palavras o que você precisa.</p>
        </div>

        <button class="botao formulario__enviar" type="submit">
          <Icone nome="send-horizontal" />
          Abrir no WhatsApp
        </button>
      </form>
    </div>
  </section>
</Base>

<script>
  const formulario = document.querySelector<HTMLFormElement>('[data-formulario]');

  if (formulario) {
    const campos = {
      nome: formulario.querySelector<HTMLInputElement>('#nome')!,
      empresa: formulario.querySelector<HTMLInputElement>('#empresa')!,
      precisa: formulario.querySelector<HTMLTextAreaElement>('#precisa')!,
    };

    const marcar = (campo: HTMLInputElement | HTMLTextAreaElement, valido: boolean) => {
      campo.setAttribute('aria-invalid', String(!valido));
      const erro = document.getElementById(`${campo.id}-erro`);
      if (erro) erro.hidden = valido;
      return valido;
    };

    formulario.addEventListener('submit', (evento) => {
      evento.preventDefault();
      const nomeOk = marcar(campos.nome, campos.nome.value.trim().length > 0);
      const precisaOk = marcar(campos.precisa, campos.precisa.value.trim().length > 0);
      if (!nomeOk) return campos.nome.focus();
      if (!precisaOk) return campos.precisa.focus();

      const nome = campos.nome.value.trim();
      const empresa = campos.empresa.value.trim();
      const apresentacao = empresa ? `Oi! Sou ${nome}, da ${empresa}.` : `Oi! Sou ${nome}.`;
      const mensagem = `${apresentacao} ${campos.precisa.value.trim()}`;
      const endereco = `https://wa.me/${formulario.dataset.whatsapp}?text=${encodeURIComponent(mensagem)}`;
      window.open(endereco, '_blank', 'noopener');
    });

    [campos.nome, campos.precisa].forEach((campo) =>
      campo.addEventListener('input', () => {
        if (campo.getAttribute('aria-invalid') === 'true') marcar(campo, campo.value.trim().length > 0);
      }),
    );
  }
</script>

<style>
  .contato {
    padding-top: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .contato__grade {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .canais {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .canal {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--borda-painel);
    border-radius: var(--raio-painel);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  a.canal:hover {
    border-color: var(--azul-claro);
    background: rgba(185, 204, 224, 0.05);
  }

  .canal .bloco {
    flex: 1;
    min-width: 0;
  }

  .canal__texto {
    display: block;
    color: var(--azul-claro);
    overflow-wrap: anywhere;
  }

  .canal :global(.canal__seta) {
    color: var(--azul-claro);
  }

  .canal--principal {
    background: var(--branco);
    border-color: var(--branco);
    color: var(--marinho);
  }

  .canal--principal .bloco strong,
  .canal--principal .canal__texto,
  .canal--principal :global(.canal__seta) {
    color: var(--marinho);
  }

  .canal--principal .selo-icone {
    background: var(--marinho);
    border-color: var(--marinho);
    color: var(--branco);
  }

  a.canal--principal:hover {
    background: var(--azul-claro);
    border-color: var(--azul-claro);
  }

  .canal--local {
    border-style: dashed;
  }

  .formulario {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .formulario__cabeca h2 {
    font-size: inherit;
  }

  .campo {
    display: grid;
    gap: 0.5rem;
  }

  .campo label {
    font-weight: 500;
  }

  .campo label span {
    color: var(--azul-claro);
    font-weight: 400;
  }

  .campo input,
  .campo textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(185, 204, 224, 0.35);
    border-radius: var(--raio);
    background: var(--marinho-fundo);
    color: var(--branco);
    font: inherit;
    resize: vertical;
  }

  .campo input:focus-visible,
  .campo textarea:focus-visible {
    outline: 2px solid var(--azul-claro);
    outline-offset: 1px;
    border-color: var(--azul-claro);
  }

  .campo textarea::placeholder {
    color: rgba(185, 204, 224, 0.75);
  }

  .campo [aria-invalid='true'] {
    border-color: var(--branco);
    border-width: 2px;
  }

  .campo__erro {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-pequeno);
    font-weight: 500;
    color: var(--branco);
  }

  .campo__erro[hidden] {
    display: none;
  }

  .campo__erro::before {
    content: '!';
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--branco);
    color: var(--marinho);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .formulario__enviar {
    justify-self: start;
    margin-top: 0.5rem;
  }

  @media (min-width: 60rem) {
    .contato__grade {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
    }
  }
</style>
