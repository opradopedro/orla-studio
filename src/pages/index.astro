---
import Base from '../layouts/Base.astro';
import Conversa, { type Mensagem } from '../components/Conversa.astro';
import Onda from '../components/Onda.astro';
import Icone from '../components/Icone.astro';
import Mar from '../components/Mar.astro';
import VisualAgenda from '../components/VisualAgenda.astro';
import VisualReativacao from '../components/VisualReativacao.astro';
import VisualSistema from '../components/VisualSistema.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import { caminho, linkWhatsApp } from '../config';

const conversa: Mensagem[] = [
  { de: 'cliente', hora: '23:12', texto: 'Boa noite! Vocês têm horário pra limpeza essa semana?' },
  {
    de: 'empresa',
    hora: '23:12',
    texto: 'Boa noite! Tenho estes horários livres:',
    opcoes: ['Quarta, 9h', 'Quinta, 14h30', 'Sexta, 10h'],
  },
  { de: 'cliente', hora: '23:13', texto: 'Quinta, 14h30', escolhida: 'Quinta, 14h30' },
  { de: 'empresa', hora: '23:13', texto: 'Pronto, marcado: limpeza na quinta às 14h30.' },
  { de: 'cliente', hora: '23:14', texto: 'Vocês aceitam cartão?' },
  { de: 'empresa', hora: '23:14', texto: 'Aceitamos sim: débito, crédito e Pix.' },
  { de: 'cliente', hora: '23:15', texto: 'Ah, na verdade quinta não vou conseguir. Tem na sexta à tarde?' },
  {
    de: 'empresa',
    hora: '23:15',
    texto: 'Sexta à tarde está tudo ocupado. Posso deixar pré-agendado em um destes:',
    opcoes: ['Segunda, 15h', 'Terça, 16h30', 'Sábado, 9h'],
  },
  {
    de: 'empresa',
    hora: '23:15',
    texto: 'E coloco você na lista de espera da sexta à tarde. Se vagar um horário, te aviso na hora.',
  },
  { de: 'cliente', hora: '23:16', texto: 'Terça, 16h30', escolhida: 'Terça, 16h30' },
  {
    de: 'empresa',
    hora: '23:16',
    texto: 'Feito! Remarquei para terça às 16h30. Te aviso 2 dias antes e no dia da consulta, pra não esquecer.',
  },
  {
    de: 'empresa',
    hora: '23:16',
    texto: 'Se acontecer algum imprevisto, é só mandar mensagem aqui até 24h antes que a gente remarca.',
  },
  {
    de: 'empresa',
    hora: '23:16',
    texto: 'Aqui está o endereço. Até terça!',
    local: { titulo: 'Como chegar', endereco: 'Av. da Orla, 100, Praia Grande' },
  },
];

const funcoes = [
  { icone: 'message-circle', texto: 'Tira dúvidas' },
  { icone: 'calendar-check', texto: 'Marca e remarca' },
  { icone: 'calendar-clock', texto: 'Deixa pré-agendado' },
  { icone: 'list-restart', texto: 'Lista de espera' },
  { icone: 'bell-ring', texto: 'Lembretes antes do horário' },
  { icone: 'map-pin', texto: 'Manda o endereço' },
];

const servicos = [
  {
    nome: 'Secretária IA',
    icone: 'calendar-clock',
    texto:
      'Quem manda mensagem às 23h já sai com horário marcado. A agenda se organiza sem ninguém da equipe parar o que está fazendo.',
    itens: [
      'Responde dúvidas com as informações do seu negócio',
      'Marca, remarca e cancela direto na agenda',
      'Lembretes antes do horário, quantos você quiser',
    ],
    href: '/secretaria-ia',
    link: 'Conhecer a Secretária IA',
  },
  {
    nome: 'Reativação de clientes',
    icone: 'refresh-ccw',
    texto:
      'Quem não volta desde o ano passado recebe uma mensagem educada e marca o retorno ali mesmo. Sem gastar com anúncio: a campanha usa a lista que você já tem.',
    itens: [
      'Uma campanha rápida ou rodando o ano todo',
      'Só para quem já é seu cliente, com opção de sair',
      'Quem volta já cai na agenda com lembrete',
    ],
    href: '/reativacao-de-clientes',
    link: 'Ver como funciona a reativação',
  },
  {
    nome: 'Sites e sistemas',
    icone: 'layout-dashboard',
    texto:
      'O estoque sai do caderno, os clientes ficam organizados num só lugar e o seu site aparece quando alguém procura pelo seu serviço na cidade.',
    itens: ['Sites e landing pages', 'Cardápio digital', 'CRM, controle de estoque e painéis'],
    href: '/sites-e-sistemas',
    link: 'Ver sites e sistemas',
  },
];

const passos = [
  {
    nome: 'Conversa',
    icone: 'messages-square',
    texto:
      'Você conta como o seu negócio funciona hoje e o que está travando. Pode ser no seu espaço, se você estiver na Baixada, ou por vídeo.',
  },
  {
    nome: 'Protótipo',
    icone: 'smartphone',
    texto:
      'Você testa uma primeira versão funcionando, com os dados do seu negócio, e pede os ajustes antes de tudo ir para o ar.',
  },
  {
    nome: 'Implantação',
    icone: 'plug',
    texto:
      'A gente coloca no ar, conecta com o que você já usa, como WhatsApp, agenda ou planilhas, e ensina a sua equipe a usar.',
  },
  {
    nome: 'Acompanhamento mensal',
    icone: 'chart-line',
    texto: 'Todo mês a gente vê como está sendo usado, ajusta o que precisar e te conta o que mudou.',
  },
];
---

<Base
  titulo="Orla Studio | Secretária IA para WhatsApp em Praia Grande"
  descricao="Estúdio de tecnologia em Praia Grande (SP). A Secretária IA atende o WhatsApp da sua clínica 24 horas, marca na agenda e confirma o paciente. Também fazemos reativação de clientes, sites e sistemas."
>
  <!-- Hero -->
  <section class="hero amanhecer" aria-labelledby="hero-titulo" data-progresso>
    <div class="conteiner hero__grade">
      <div class="hero__texto">
        <p class="rotulo">Praia Grande, SP</p>
        <h1 id="hero-titulo">Tecnologia que trabalha enquanto você atende.</h1>
        <p class="apoio">
          A Orla cria sistemas e automações para pequenos negócios. O carro-chefe é a Secretária IA: ela
          atende o WhatsApp da sua empresa a qualquer hora e cuida da agenda enquanto você cuida de quem
          está na sua frente.
        </p>
        <div class="hero__botoes">
          <a class="botao" href={caminho('/secretaria-ia')}>Conhecer a Secretária IA</a>
          <a class="botao botao--contorno" href={linkWhatsApp()} target="_blank" rel="noopener">
            <Icone nome="message-circle" />
            Falar no WhatsApp
          </a>
        </div>
      </div>

      <div class="hero__palco">
        <div class="hero__cartao hero__cartao--a painel" aria-hidden="true">
          <span class="hero__cartao-icone"><Icone nome="calendar-check" /></span>
          <span><strong>Agenda atualizada</strong><span>Terça, 16h30</span></span>
        </div>
        <div class="hero__cartao hero__cartao--b painel" aria-hidden="true">
          <span class="hero__cartao-icone"><Icone nome="list-restart" /></span>
          <span><strong>Lista de espera</strong><span>Sexta à tarde</span></span>
        </div>
        <Conversa
          class="hero__conversa"
          contato="Sua clínica"
          mensagens={conversa}
          legenda="Exemplo de conversa com a Secretária IA"
        />
      </div>
    </div>
    <div class="hero__mar" aria-hidden="true">
      <Mar />
      <Onda tipo="linhas" class="hero__ondas" />
    </div>
  </section>

  <!-- Destaque: tudo o que aparece na conversa vai direto para a agenda -->
  <section class="conectado" aria-labelledby="conectado-titulo">
    <div class="conteiner">
      <div class="conectado__caixa escuro">
        <div class="conectado__titulo">
          <span class="conectado__selo"><Icone nome="calendar-sync" /></span>
          <h2 id="conectado-titulo">Tudo isso conectado com a sua agenda.</h2>
        </div>
        <ul class="conectado__funcoes">
          {
            funcoes.map((funcao) => (
              <li>
                <Icone nome={funcao.icone} />
                {funcao.texto}
              </li>
            ))
          }
          <li class="conectado__mais">
            <Icone nome="plus" />E mais o que você precisar
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Serviços: o palco da esquerda troca de tela conforme a rolagem -->
  <section class="secao servicos" aria-labelledby="servicos-titulo" data-servicos data-ativo="0">
    <div class="conteiner">
      <div class="cabeca-secao cabeca-secao--lado">
        <h2 id="servicos-titulo">Onde a gente pode ajudar</h2>
        <p class="apoio">
          Do WhatsApp que não para de tocar ao controle que ainda está no caderno. Cada negócio tem o seu
          gargalo, e a gente constrói em cima dele.
        </p>
      </div>

      <div class="servicos__grade">
        <div class="servicos__palco" data-progresso aria-hidden="true">
          <div class="servicos__fundo">
            <Mar />
          </div>
          <div class="servicos__tela" data-indice="0"><VisualAgenda /></div>
          <div class="servicos__tela" data-indice="1"><VisualReativacao /></div>
          <div class="servicos__tela" data-indice="2"><VisualSistema /></div>
        </div>

        <div class="servicos__lista">
          {
            servicos.map((servico, indice) => (
              <article class="servico" data-servico={indice}>
                <div class="servico__visual">
                  {indice === 0 && <VisualAgenda />}
                  {indice === 1 && <VisualReativacao />}
                  {indice === 2 && <VisualSistema />}
                </div>
                <div class="servico__cabeca">
                  <span class="selo-icone">
                    <Icone nome={servico.icone} />
                  </span>
                  <h3>{servico.nome}</h3>
                </div>
                <div class="servico__corpo">
                  <p>{servico.texto}</p>
                  <ul class="servico__itens">
                    {servico.itens.map((item) => (
                      <li>
                        <Icone nome="check" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                <a class="botao botao--contorno servico__botao" href={caminho(servico.href)}>
                  {servico.link}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Como trabalhamos: no computador, os passos andam para o lado com a rolagem -->
  <Onda cor="var(--azul-medio)" />
  <section class="processo claro" aria-labelledby="processo-titulo" data-horizontal>
    <div class="processo__fixo">
      <div class="conteiner">
        <div class="cabeca-secao cabeca-secao--lado processo__cabeca">
          <h2 id="processo-titulo">Como a gente trabalha</h2>
          <p class="apoio">Do primeiro papo ao acompanhamento, você fala sempre com as mesmas pessoas.</p>
        </div>
      </div>
      <div class="processo__janela">
        <ol class="processo__trilho" data-trilho>
          {
            passos.map((passo, indice) => (
              <li class="passo painel" data-revelar>
                <div class="passo__topo">
                  <span class="passo__numero" aria-hidden="true">
                    {String(indice + 1).padStart(2, '0')}
                  </span>
                  <span class="selo-icone">
                    <Icone nome={passo.icone} />
                  </span>
                </div>
                <div class="bloco">
                  <h3>{passo.nome}</h3>
                  <p>{passo.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="conteiner">
        <div class="processo__progresso" aria-hidden="true"><span></span></div>
      </div>
    </div>
  </section>

  <!-- Quem somos -->
  <Onda cor="var(--azul-medio)" invertida />

  <section class="secao quem" aria-labelledby="quem-titulo">
    <div class="conteiner quem__grade">
      <div class="quem__texto">
        <h2 id="quem-titulo">Quem atende você é quem constrói.</h2>
        <!-- TODO: se quiserem, colocar aqui uma foto real de vocês (sem foto de banco de imagens). -->
        <p>
          Na Orla, você tem contato direto com quem monta o seu sistema. Quem entende o seu problema é quem
          constrói a solução e continua do seu lado depois que tudo está no ar.
        </p>
        <p>
          Você não fala com central nem com um vendedor que some depois do contrato. Fala direto com quem fez,
          pelo mesmo WhatsApp de sempre.
        </p>
        <a class="botao" href={caminho('/sobre')}>Conhecer a Orla</a>
      </div>

      <ul class="lista-icones quem__lista">
        <li>
          <span class="selo-icone"><Icone nome="headset" /></span>
          <div class="bloco">
            <h3>Atendimento direto</h3>
            <p>Pelo WhatsApp, com quem conhece o seu projeto do começo ao fim.</p>
          </div>
        </li>
        <li>
          <span class="selo-icone"><Icone nome="workflow" /></span>
          <div class="bloco">
            <h3>Feito por nós</h3>
            <p>Nada é repassado para terceiros. A gente constrói e cuida de tudo.</p>
          </div>
        </li>
        <li>
          <span class="selo-icone"><Icone nome="calendar-sync" /></span>
          <div class="bloco">
            <h3>Acompanhamento todo mês</h3>
            <p>Revisamos as conversas, ajustamos o que precisar e contamos o que mudou.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>
  <ChamadaFinal />
</Base>

<script>
  // Serviços: marca qual serviço está no meio da tela para trocar a tela do palco.
  const secao = document.querySelector<HTMLElement>('[data-servicos]');
  if (secao && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (entrada.isIntersecting) {
            secao.dataset.ativo = (entrada.target as HTMLElement).dataset.servico ?? '0';
          }
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    secao.querySelectorAll('[data-servico]').forEach((servico) => observador.observe(servico));
  }
</script>

<style>
  /* Hero: o texto fica acima da linha do horizonte e o celular se apoia nela. */
  .hero {
    --altura-ondas: clamp(8rem, 5rem + 9vw, 13rem);
    position: relative;
    padding-top: clamp(3rem, 2rem + 5vw, 6.5rem);
    padding-bottom: var(--altura-ondas);
    overflow: hidden;
  }

  .hero__grade {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: end;
  }

  .hero__texto {
    align-self: center;
    padding-bottom: 2rem;
  }

  .hero__texto .rotulo {
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    max-width: 11.5em;
  }

  .hero .apoio {
    margin-top: 1.75rem;
    max-width: 30em;
  }

  .hero__botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .hero__palco {
    position: relative;
    justify-self: center;
    width: min(100%, 22rem);
  }

  .hero__palco :global(.hero__conversa) {
    position: relative;
    z-index: 1;
    margin-bottom: -1px;
  }

  .hero__cartao {
    display: none;
  }

  .hero__mar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--altura-ondas);
    border-top: 1px solid var(--linha);
  }

  .hero__mar :global(.hero__ondas) {
    position: absolute;
    left: 0;
    right: 0;
    top: -1.5rem;
    height: 3.5rem;
    opacity: 0.8;
  }

  .hero :global(.conversa__legenda) {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: 0.85rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--painel);
  }

  @media (max-width: 47.99rem) {
    .hero__botoes .botao {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 60rem) {
    .hero__grade {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }

    .hero__grade::before {
      content: '';
      position: absolute;
      top: -10rem;
      bottom: 0;
      left: calc(58.33% + 1rem);
      width: 1px;
      background: var(--linha);
    }

    .hero__palco {
      justify-self: end;
    }

    /* Cartões que flutuam ao lado do celular e se deslocam com a rolagem */
    .hero__cartao {
      position: absolute;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.8rem 1.1rem 0.8rem 0.8rem;
      background: var(--painel-2);
      font-size: 0.8125rem;
      line-height: 1.35;
      white-space: nowrap;
      box-shadow: 0 24px 48px -20px rgba(7, 36, 71, 0.24);
    }

    .hero__cartao strong {
      display: block;
    }

    .hero__cartao span span {
      color: var(--acento);
    }

    .hero__cartao-icone {
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      background: var(--tinta);
      color: var(--papel);
    }

    .hero__cartao-icone :global(.icone) {
      width: 1.05rem;
      height: 1.05rem;
    }

    .hero__cartao--a {
      top: 22%;
      right: calc(100% - 1rem);
      transform: translateY(calc(var(--p, 0.5) * -90px));
    }

    .hero__cartao--b {
      bottom: 18%;
      right: calc(100% - 0.5rem);
      transform: translateY(calc(var(--p, 0.5) * -160px));
    }
  }

  /* Destaque da agenda: cartão azul escuro com as funções em blocos */
  .conectado {
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .conectado__caixa {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border-radius: calc(var(--raio-painel) + 8px);
  }

  .conectado__titulo {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .conectado__selo {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 14px;
    background: var(--tinta);
    color: var(--papel);
  }

  .conectado__selo :global(.icone) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .conectado h2 {
    font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2.5rem);
    max-width: 12em;
  }

  .conectado__funcoes {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .conectado__funcoes li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--borda-painel);
    border-radius: 14px;
    background: var(--painel);
    font-size: var(--t-pequeno);
    font-weight: 500;
    line-height: 1.35;
  }

  .conectado__funcoes :global(.icone) {
    color: var(--acento);
  }

  .conectado__funcoes .conectado__mais {
    background: var(--tinta);
    border-color: var(--tinta);
    color: var(--papel);
  }

  .conectado__mais :global(.icone) {
    color: var(--papel);
  }

  @media (min-width: 48rem) {
    .conectado__funcoes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .conectado__caixa {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: center;
      gap: 3rem;
    }
  }

  /* Serviços */
  .servicos__lista {
    display: grid;
    gap: 0;
  }

  .servicos__palco {
    display: none;
  }

  .servico {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: 3rem;
  }

  /* No celular, uma linha separa um serviço do outro */
  .servico + .servico {
    border-top: 1px solid var(--linha);
  }

  .servico:first-child {
    padding-top: 0;
  }

  .servico__visual {
    width: 100%;
    margin-bottom: 0.5rem;
  }

  .servico__cabeca {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .servico__cabeca h3 {
    font-size: var(--t-h3);
  }

  .servico__corpo {
    display: grid;
    gap: 1.25rem;
    color: var(--acento);
    max-width: 34em;
  }

  .servico__itens {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    color: var(--tinta);
  }

  .servico__itens li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .servico__itens :global(.icone) {
    margin-top: 0.2rem;
    color: var(--acento);
  }

  @media (min-width: 60rem) {
    .servicos__grade {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 5rem;
    }

    .servicos__palco {
      position: sticky;
      top: calc(var(--altura-menu) + 4rem);
      display: grid;
      place-items: center;
      height: calc(100vh - var(--altura-menu) - 8rem);
      min-height: 30rem;
      max-height: 40rem;
    }

    /* Fundo do palco: um painel azul claro com o mar de pontos embaixo */
    .servicos__fundo {
      position: absolute;
      inset: 0;
      border-radius: calc(var(--raio-painel) + 8px);
      background: var(--azul-medio);
      overflow: hidden;
    }

    .servicos__fundo :global(.mar) {
      position: absolute;
      left: 0;
      bottom: 0;
      height: 45%;
    }

    .servicos__tela {
      position: relative;
      z-index: 1;
      grid-area: 1 / 1;
      width: min(86%, 30rem);
      opacity: 0;
      transform: translateY(24px) scale(0.97);
      transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
      pointer-events: none;
    }

    [data-ativo='0'] .servicos__tela[data-indice='0'],
